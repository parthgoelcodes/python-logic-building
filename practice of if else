def check_age(age):
    if age <=0:
        print("invalid age")
    elif age<18:
        print("minor")
    elif age<=59:
        print("adult")
    else:
        print("senior citizen")

check_age(12)
check_age(18)
check_age(59)
check_age(14)
check_age(69)
